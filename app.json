{
  "expo": {
    "name": "GoPlan",
    "slug": "evento-app",
    "owner": "sergicruga",
    "version": "1.0.1",
    "orientation": "default",
    "icon": "./assets/goplan-logo.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/goplan-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Necesitamos acceder a tus fotos para elegir la imagen del evento",
        "NSLocationWhenInUseUsageDescription": "Necesitamos tu ubicación para elegir el lugar del evento.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.sergicruga.eventoapp"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/goplan-logo.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyC5OaOH5s6obmHZNMzw8bO6hXuh7G6I7cw"
        }
      },
      "package": "com.sergicruga.eventoapp",
      "versionCode": 100,
      "usesCleartextTraffic": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "plugins": [
          "expo-image-picker",
          "expo-image-picker"
        ],
        "projectId": "ec7b6a65-2245-4b94-9f89-7183cae09276"
      }
    },
    "plugins": [
      "expo-font",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-9396892293971176~4708610502",
          "iosAppId": "ca-app-pub-9396892293971176~4708610502"
        }
      ]
    ]


  }
}
